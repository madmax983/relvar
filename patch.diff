+impl<'a> TryFrom<&'a ScalarValue> for i64 {
+    type Error = ();
+    fn try_from(value: &'a ScalarValue) -> Result<Self, Self::Error> {
+        match value {
+            ScalarValue::Int(v) => Ok(*v),
+            _ => Err(()),
+        }
+    }
+}
